<nav aria-label="Pagination" class="d-flex justify-content-center">
	<ul class="pagination">
		{% for page in pagination.pages %}
			<li class="page-item {% if page.active %}active{% endif %}">
				<a class="page-link" href="{{ page.url }}">
					{{ page.label }}
				</a>
			</li>
		{% endfor %}
	</ul>
</nav>

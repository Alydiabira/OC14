{% extends 'base.html.twig' %}

{% block body %}
	<div class="container">
		<div class="row mb-4">
			<div class="col">
				<div class="rounded-5 bg-light p-4 d-flex flex-column align-items-center">
					<h1 class="mb-4 text-center text-uppercase">{{ game.title }}</h1>

					<div class="tags d-flex justify-content-center gap-3 mb-3">
						{% for tag in game.tags %}
							<span class="badge bg-primary">{{ tag.name }}</span>
						{% endfor %}
					</div>

					<small class="text-muted">
						Sortie :
						{{ game.releaseDate|date('m/d/Y') }}
					</small>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-md-4">
				<img src="{{ vich_uploader_asset(game, 'imageFile', 'App\\Model\\Entity\\VideoGame') }}" class="img-fluid rounded" alt="Couverture de {{ game.title|e }}">

				<div class="ratings justify-content-between mt-3">
					<twig:Rating rating="{{ game.rating }}" label="Test"/>
					{% if game.averageRating is not null %}
						<twig:Rating rating="{{ game.averageRating }}" label="Avis"/>
					{% endif %}
				</div>

				<div class="mt-4">
					<h2 class="text-uppercase">Notes ({{ game.reviews|length }})</h2>
					<ul class="d-flex flex-column gap-2 p-0">

						<li class="d-flex gap-2 align-items-center">
							<span>5/5</span>
							{{ component('Progress', { videoGame: game, number: game.numberOfRatingsPerValue.numberOfFive }) }}
							<span>{{ game.numberOfRatingsPerValue.numberOfFive }}</span>
						</li>

						<li class="d-flex gap-2 align-items-center">
							<span>4/5</span>
							{{ component('Progress', { videoGame: game, number: game.numberOfRatingsPerValue.numberOfFour }) }}
							<span>{{ game.numberOfRatingsPerValue.numberOfFour }}</span>
						</li>

						<li class="d-flex gap-2 align-items-center">
							<span>3/5</span>
							{{ component('Progress', { videoGame: game, number: game.numberOfRatingsPerValue.numberOfThree }) }}
							<span>{{ game.numberOfRatingsPerValue.numberOfThree }}</span>
						</li>

						<li class="d-flex gap-2 align-items-center">
							<span>2/5</span>
							{{ component('Progress', { videoGame: game, number: game.numberOfRatingsPerValue.numberOfTwo }) }}
							<span>{{ game.numberOfRatingsPerValue.numberOfTwo }}</span>
						</li>

						<li class="d-flex gap-2 align-items-center">
							<span>1/5</span>
							{{ component('Progress', { videoGame: game, number: game.numberOfRatingsPerValue.numberOfOne }) }}
							<span>{{ game.numberOfRatingsPerValue.numberOfOne }}</span>
						</li>

					</ul>
				</div>
			</div>

			<div class="col-8">
				<twig:Tabs>

					{% block home %}
						<div class="bg-light p-3 rounded">
							<h2 class="text-uppercase">Description</h2>
							{{ game.description|nl2br }}
						</div>
					{% endblock %}

					{% block test %}
						<div class="bg-light p-3 rounded">
							<h2 class="text-uppercase">Test CritiPixel</h2>
							{{ game.test|nl2br }}
						</div>
					{% endblock %}

					{% block reviews %}
						<div class="bg-light p-3 rounded">
							<h2 class="text-uppercase">Avis des lecteurs</h2>

							{% if is_granted('review', game) %}
								<div class="mb-4">
									{{ form_start(form) }}
									{{ form_errors(form) }}

									<fieldset class="mb-3">
										{{ form_row(form.rating) }}
										{{ form_row(form.comment) }}
									</fieldset>


									<button class="btn btn-primary py-2" type="submit">Poster</button>

									{{ form_end(form) }}
								</div>
							{% endif %}

							<div class="list-group">
								{% for review in game.reviews %}
									{{ component('Review', { review: review }) }}
								{% endfor %}
							</div>
						</div>
					{% endblock %}

				</twig:Tabs>
			</div>
		</div>
	</div>
{% endblock %}
